---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/global.css';

const pageTitle = 'READINGS';
const allReadings = Object.values(
  import.meta.glob('./readings/*.md', { eager: true }),
).sort((a: any, b: any) => {
  const aDate = a.frontmatter.finishedDate ?? a.frontmatter.pubDate ?? 0;
  const bDate = b.frontmatter.finishedDate ?? b.frontmatter.pubDate ?? 0;
  return new Date(bDate).getTime() - new Date(aDate).getTime();
});

function formatDate(date: string | Date | undefined): string | null {
  if (!date) return null;

  return new Date(date).toLocaleDateString('ja-JP', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}
---

<BaseLayout pageTitle={pageTitle}>
  <p class="mt-8 text-gray-400 md:mt-12">
    読んだ技術書の要点、学び、あとで試したいことをまとめています。
  </p>

  {allReadings.length > 0 ? (
    <ul class="mt-8 space-y-4 md:mt-12 md:space-y-5">
      {allReadings.map((reading: any) => {
        const date = formatDate(reading.frontmatter.finishedDate ?? reading.frontmatter.pubDate);

        return (
          <li class="border-b border-gray-700 pb-4 md:pb-5">
            <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between sm:gap-4">
              <a href={reading.url} class="font-bold text-white no-underline hover:text-green-400">
                {reading.frontmatter.title}
              </a>
              {date && <span class="shrink-0 text-sm text-gray-500">{date}</span>}
            </div>
            {reading.frontmatter.bookAuthor && (
              <p class="mt-1 text-sm text-gray-500">著者: {reading.frontmatter.bookAuthor}</p>
            )}
            {reading.frontmatter.description && (
              <p class="mt-2 text-sm leading-relaxed text-gray-400 md:text-base">
                {reading.frontmatter.description}
              </p>
            )}
          </li>
        );
      })}
    </ul>
  ) : (
    <p class="mt-10 rounded-lg border border-dashed border-gray-700 px-5 py-6 text-gray-500">
      読書メモは準備中です。
    </p>
  )}
</BaseLayout>
